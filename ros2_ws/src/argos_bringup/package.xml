<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>argos_bringup</name>
  <version>0.0.0</version>
  <description>ARGOS bringup: base driver, wheel odometry, YDLIDAR, TF, SLAM</description>
  <maintainer email="odyssey@todo.todo">odyssey</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>argos_odometry</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
